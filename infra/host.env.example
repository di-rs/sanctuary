# Install as /etc/sanctuary/host.env with mode 0600. Use existing account identifiers.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-account-id
SANCTUARY_R2_BUCKET=sanctuary-delivery
AWS_ACCESS_KEY_ID=replace-with-bucket-read-key-id
AWS_SECRET_ACCESS_KEY=replace-with-bucket-read-secret
PLAYGROUND_HOST=play.example.net
PREVIEW_ZONE=example.net
GRAFANA_HOST=grafana.example.net
ACCESS_TEAM_HOST=example.cloudflareaccess.com
GRAFANA_ACCESS_AUD=replace-with-grafana-application-audience
ADMIN_EMAIL=operator@example.net
TEMPORAL_HOST=temporal.example.net
TUNNEL_TOKEN_FILE=/etc/sanctuary/tunnel-token
ALERT_WEBHOOK_FILE=/etc/sanctuary/alert-webhook
BOXIE_TEMPORAL_ADDRESS=temporal:7233
BOXIE_TEMPORAL_SERVER_NAME=temporal
BOXIE_TEMPORAL_NAMESPACE=boxie
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
