[Unit]
Description=Reconcile Sanctuary service deployments
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sanctuary
EnvironmentFile=/etc/sanctuary/host.env
Environment=PATH=/opt/sanctuary-tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
Environment=AWS_EC2_METADATA_DISABLED=true
UMask=0077
ExecStart=/bin/bash /opt/sanctuary/infra/control/sync.sh
TimeoutStartSec=45min
