{
  "name": "@sanctuary/dependency-updates",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "cd ../.. && renovate-config-validator --strict renovate.json && node tools/dependency-updates/check.mjs tools/dependency-updates/node_modules/renovate",
    "check:assets": "cd ../.. && node tools/dependency-updates/check.mjs tools/dependency-updates/node_modules/renovate --verify-assets"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "devDependencies": {
    "renovate": "44.186.8"
  }
}
